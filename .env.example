# Copy to .env and fill in. NEVER commit .env or real keys.

# --- Primary path: connect AMBER memory layer ---
AMBER_BASE_URL=https://YOUR_AMBER_HOST/v1
AMBER_API_KEY=
# Optional model name served by your AMBER gateway
AMBER_MODEL=deepseek-chat
# Memory on/off for the C arm (also sent as header; see below)
AMBER_MEMORY=on
# Header-based switch (documented contract; gateway may ignore unknown headers)
AMBER_MEMORY_HEADER=X-AMBER-Memory
AMBER_MEMORY_HEADER_ON=on
AMBER_MEMORY_HEADER_OFF=off
# Optional dual endpoints instead of a header switch:
# AMBER_BASE_URL_MEMORY_ON=https://YOUR_AMBER_HOST/v1
# AMBER_BASE_URL_MEMORY_OFF=https://YOUR_AMBER_HOST/v1

# --- Upstream (A_plain + B_fullctx baseline, and local_sim backend) ---
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=
# Alias accepted by harness:
# DEEPSEEK_API_KEY=

# --- Dataset ---
# Default reproduce fixture:
AMBER_DATA_DIR=reference/fair_r2
# Or your own / the sample:
# AMBER_DATA_DIR=data/sample_minimal
# AMBER_CORPUS_DIR=data/my_corp   # alias of AMBER_DATA_DIR

# --- Backend ---
# amber = hit AMBER for C (default) | local_sim = reproduce published raw numbers
AMBER_BENCH_BACKEND=amber
